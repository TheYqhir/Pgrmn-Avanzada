void setup() {
  Serial.begin(115200);
}

void loop() {
  // Simulación de temperatura
  float temp = 22.0 + random(-50, 50) / 10.0;

  // Simulación de LDR (0–1023)
  int ldr = random(0, 1023);

  // Enviar datos en formato que Python entiende
  Serial.print(temp);
  Serial.print(",");
  Serial.println(ldr);

  delay(1000); // cada 1 segundo
}
